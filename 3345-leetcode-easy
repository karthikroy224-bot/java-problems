class Solution {
    public int smallestNumber(int n, int t) {
        int sum=0;
        for(int i=0;i<=10;i++){
        sum=n+i;
        int temp=sum;
        int pro=1;
        while(temp!=0){
            pro*=temp%10;
            temp/=10;
        }
        if(pro%t==0){
            break;
            }
        }
        return sum;
    }
}
