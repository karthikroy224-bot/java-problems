class Solution {
    public void duplicateZeros(int[] arr) {
        int index=0;
        int[] newarr=new int[arr.length];
        for(int i=0;i<arr.length;i++){
            if(index<arr.length){
                if(arr[i]!=0){
                newarr[index]=arr[i];
                index++;
                }
                else{
                    newarr[index]=arr[i];
                    if(index+1<arr.length){newarr[index+1]=arr[i];}
                    index+=2;
                }
            }
            else{break;}
        }
        for(int i=0;i<arr.length;i++){
            arr[i]=newarr[i];
        }
    }
}
