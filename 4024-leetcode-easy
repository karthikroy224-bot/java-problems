class Solution {
    public int nearestDrone(int[][] drones, int[] target) {
        int row=drones.length;
        int min=Integer.MAX_VALUE;
        int minInd=-1;
        for(int i=0;i<row;i++){
            int distance=Math.abs(drones[i][0]-target[0])+
                Math.abs(drones[i][1]-target[1]);
            if(distance<=drones[i][2]){
                if(distance<min){
                min=distance;
                minInd=i;
                }
            }
        }
        return minInd;
    }
}
