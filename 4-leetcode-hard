import java.util.*;
class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int[] arr= new int[nums1.length+nums2.length];
        int i=0;
        for(int each: nums1){arr[i++]=each;}
        for(int each: nums2){arr[i++]=each;}
        Arrays.sort(arr);
        double median=0;
        if(arr.length%2!=0){
            median=arr[arr.length/2];
            return median;
        }
        else{
            median=(arr[(arr.length/2)-1]+arr[arr.length/2])/2.0;
            return median;
        }
    }
}
